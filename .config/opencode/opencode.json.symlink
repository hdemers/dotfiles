{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/Qwen3.8-27B-NVFP4-XQA",
  "small_model": "local/Qwen3.8-27B-NVFP4-XQA",
  "plugin": [
    "opencode-gemini-auth@1.3.11"
  ],
  "provider": {
    "google": {
      "options": {
        "projectId": "wonder-sandbox"
      },
      "models": {
        "gemini-3-pro-preview": {
          "options": {
            "thinkingConfig": {
              "thinkingLevel": "high",
              "includeThoughts": true
            }
          }
        },
        "gemini-2.5-flash": {
          "options": {
            "thinkingConfig": {
              "thinkingBudget": 8192,
              "includeThoughts": true
            }
          }
        }
      }
    },
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "http://127.0.0.1:4321/v1",
        "apiKey": "local"
      },
      "models": {
        "Qwen3.8-27B-NVFP4-XQA": {
          "name": "Qwen3.8 27B vLLM 262K",
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  }
}

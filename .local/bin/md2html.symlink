#!/usr/bin/env python3
"""Convert Markdown files to HTML using Pandoc with embedded Paper Theme and dark/light mode toggle."""

import argparse
import os
import subprocess
import sys
import tempfile
from pathlib import Path

CSS_CONTENT = """/* Editorial Paper Theme extracted & adapted from explainer.css for Pandoc */

:root, :root[data-theme="light"] {
  color-scheme: light;
  --paper: #f7f0df;
  --paper-raised: #fffaf0;
  --paper-deep: #eadfca;
  --ink: #2c261f;
  --ink-soft: #655b4e;
  --rule: #cdbfa7;
  --rust: #a33f27;
  --rust-deep: #702817;
  --moss: #3f604c;
  --moss-pale: #dce6d9;
  --ochre: #b87920;
  --ochre-pale: #f1dfb8;
  --blue: #385f70;
  --blue-pale: #dbe7e9;
  --rose-pale: #eed8d1;
  --shadow: 0 18px 42px rgb(73 52 29 / 11%);
  --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
  --sans: "Avenir Next", Avenir, "Gill Sans", "Trebuchet MS", sans-serif;
  --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  --code-background: #29382f;
  --code-ink: #f3eedf;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --paper: #1c1917;
    --paper-raised: #26221f;
    --paper-deep: #2d2824;
    --ink: #f3eedf;
    --ink-soft: #c2b7a7;
    --rule: #443d35;
    --rust: #e06d53;
    --rust-deep: #f0856e;
    --moss: #88b39a;
    --moss-pale: #25352c;
    --ochre: #e0a64e;
    --ochre-pale: #3a2d1d;
    --blue: #77a8ba;
    --blue-pale: #1d2d35;
    --shadow: 0 18px 42px rgb(0 0 0 / 40%);
    --code-background: #141f18;
    --code-ink: #f3eedf;
  }
}

:root[data-theme="dark"] {
  color-scheme: dark;
  --paper: #1c1917;
  --paper-raised: #26221f;
  --paper-deep: #2d2824;
  --ink: #f3eedf;
  --ink-soft: #c2b7a7;
  --rule: #443d35;
  --rust: #e06d53;
  --rust-deep: #f0856e;
  --moss: #88b39a;
  --moss-pale: #25352c;
  --ochre: #e0a64e;
  --ochre-pale: #3a2d1d;
  --blue: #77a8ba;
  --blue-pale: #1d2d35;
  --shadow: 0 18px 42px rgb(0 0 0 / 40%);
  --code-background: #141f18;
  --code-ink: #f3eedf;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0 auto;
  background:
    radial-gradient(circle at 18% 8%, rgb(184 121 32 / 7%) 0 1px, transparent 1.5px) 0 0 / 19px 19px,
    var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 1.05rem;
  line-height: 1.68;
  max-width: 58rem;
  padding: 4rem 2rem 8rem 2rem;
  transition: background-color 0.25s ease, color 0.25s ease;
}

body::before {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  height: 4px;
  content: "";
  background: var(--rust);
  pointer-events: none;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--serif);
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--ink);
  line-height: 1.25;
}

h1 {
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  line-height: 1.1;
  margin-top: 1.2em;
  margin-bottom: 0.6em;
  border-bottom: 2px solid var(--rule);
  padding-bottom: 0.3em;
  position: sticky;
  top: 0;
  z-index: 90;
  background: var(--paper);
  transition: font-size 0.2s ease, padding 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
}

h1.is-stuck {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100vw !important;
  font-size: 1.25rem !important;
  line-height: 1.3 !important;
  margin: 0 !important;
  padding: 0.75rem 2rem !important;
  background: var(--paper-raised) !important;
  border-bottom: 1px solid var(--rule) !important;
  box-shadow: var(--shadow) !important;
  border-radius: 0 !important;
  z-index: 9999 !important;
}

h2 {
  font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  margin-top: 1.8em;
  margin-bottom: 0.5em;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 0.25em;
  color: var(--rust-deep);
}

h3 {
  font-size: clamp(1.3rem, 2.5vw, 1.7rem);
  margin-top: 1.5em;
  margin-bottom: 0.4em;
}

h4 {
  font-size: 1.15rem;
  margin-top: 1.2em;
  margin-bottom: 0.3em;
}

p {
  margin-top: 0;
  margin-bottom: 1.25em;
  color: var(--ink);
}

a {
  color: var(--rust-deep);
  text-decoration: underline;
  text-underline-offset: 0.18em;
  text-decoration-thickness: 1px;
  font-weight: 500;
}

a:hover {
  text-decoration-thickness: 2px;
}

/* Code Formatting & Syntax Highlighting */
code {
  font-family: var(--mono);
  font-size: 0.88em;
  padding: 0.12em 0.35em;
  border-radius: 0.25rem;
  background: var(--paper-deep);
  color: var(--rust-deep);
  overflow-wrap: anywhere;
}

pre, div.sourceCode pre {
  background: var(--code-background);
  color: var(--code-ink);
  border-left: 4px solid var(--moss);
  border-radius: 0 8px 8px 0;
  padding: 1.2rem 1.4rem;
  overflow-x: auto;
  font-family: var(--mono);
  font-size: 0.9rem;
  line-height: 1.6;
  margin: 1.6em 0;
  box-shadow: var(--shadow);
}

pre code, code.sourceCode {
  background: transparent !important;
  color: var(--code-ink) !important;
  padding: 0;
  border: none;
  font-size: 1em;
}

/* Python Syntax Highlighting Palette */
code.sourceCode .co { color: #8a998d; font-style: italic; } /* Comments */
code.sourceCode .kw { color: #f0856e; font-weight: bold; } /* Keywords: def, class, import, return */
code.sourceCode .cf { color: #ff7b72; font-weight: bold; } /* Control Flow: if, else, for, try, with */
code.sourceCode .fu { color: #79c0ff; font-weight: 600; } /* Functions: def function_name */
code.sourceCode .bu { color: #f2cc60; } /* Built-ins: dict, str, int, list, print, len */
code.sourceCode .dt { color: #f2cc60; font-weight: 500; } /* Data Types */
code.sourceCode .st { color: #88b39a; } /* Strings */
code.sourceCode .ch { color: #88b39a; } /* Characters */
code.sourceCode .va { color: #d8b4fe; } /* Variables & self */
code.sourceCode .at, code.sourceCode .pp { color: #ff9b71; font-weight: 500; } /* Decorators (@property) */
code.sourceCode .fl, code.sourceCode .dv, code.sourceCode .bn { color: #f0a85d; } /* Numbers */
code.sourceCode .cn { color: #f0a85d; font-weight: bold; } /* Constants: True, False, None */
code.sourceCode .op { color: #c3baa6; } /* Operators: =, :, +, -, -> */
code.sourceCode .ex { color: #ff7b72; font-weight: bold; } /* Exceptions: ValueError */
code.sourceCode .er { color: #ff7b72; text-decoration: underline; } /* Errors */

/* Code block anchor links */
code.sourceCode > span > a {
  color: #4a5c51 !important;
  text-decoration: none !important;
  user-select: none;
}

/* Blockquotes */
blockquote {
  margin: 1.6em 0;
  padding: 1rem 1.4rem;
  border-left: 4px solid var(--rust);
  background: var(--paper-raised);
  color: var(--ink-soft);
  font-family: var(--serif);
  font-style: italic;
  font-size: 1.08rem;
  border-radius: 0 8px 8px 0;
  box-shadow: var(--shadow);
}

blockquote p:last-child {
  margin-bottom: 0;
}

/* Tables */
table {
  width: 100%;
  border-collapse: collapse;
  margin: 1.8em 0;
  background: var(--paper-raised);
  border: 1px solid var(--rule);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

th, td {
  padding: 0.85rem 1rem;
  border-bottom: 1px solid var(--rule);
  text-align: left;
  vertical-align: top;
}

th {
  font-family: var(--serif);
  font-weight: 600;
  color: var(--rust-deep);
  background: var(--paper-deep);
  font-size: 0.95rem;
  letter-spacing: 0.03em;
}

tr:last-child td {
  border-bottom: none;
}

tr:nth-child(even) td {
  background: rgb(0 0 0 / 2%);
}

/* Lists */
ul, ol {
  padding-left: 1.8rem;
  margin-bottom: 1.25em;
}

li {
  margin-bottom: 0.35em;
}

li::marker {
  color: var(--rust);
}

/* Horizontal Rule */
hr {
  border: none;
  border-top: 1px solid var(--rule);
  margin: 2.5em 0;
}

/* Table of Contents - Default (Mobile & Small Screens) */
#TOC {
  background: var(--paper-raised);
  border: 1px solid var(--rule);
  border-radius: 10px;
  padding: 1rem 1.4rem;
  margin-bottom: 2.5em;
  box-shadow: var(--shadow);
}

#TOC::before {
  content: "Table of Contents";
  display: block;
  font-family: var(--serif);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--rust-deep);
  margin-bottom: 0.6rem;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 0.35rem;
  letter-spacing: 0.02em;
}

#TOC > ul {
  padding-left: 1.2rem;
  margin: 0;
}

#TOC ul {
  padding-left: 1rem;
  list-style-type: circle;
}

#TOC li {
  margin-bottom: 0.3rem;
  line-height: 1.35;
}

#TOC li::marker {
  color: var(--rule);
}

#TOC li.active-li,
#TOC li:has(> a.active) {
  list-style-type: disc;
}

#TOC li.active-li::marker,
#TOC li:has(> a.active)::marker {
  color: var(--rust);
}

#TOC a {
  color: var(--ink);
  font-family: var(--sans);
  font-size: 0.82rem;
  transition: color 0.15s ease;
}

#TOC a:hover {
  color: var(--rust-deep);
}

#TOC a.active {
  color: var(--rust-deep) !important;
  font-weight: 700;
}

/* Sticky Sidebar Table of Contents for Desktop Screens */
@media (min-width: 1150px) {
  body {
    margin-left: 400px;
    margin-right: 1.5rem;
    max-width: none;
    padding-left: 1rem;
    padding-right: 1.5rem;
  }

  #TOC {
    position: fixed;
    top: 80px;
    left: 1.5rem;
    width: 340px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    padding: 1.2rem 1.4rem;
    margin-bottom: 0;
    z-index: 100;
  }
}

/* Hamburger Reader Settings Menu Styling */
.theme-menu-wrapper {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 99999;
  font-family: var(--sans);
}

.theme-menu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background: var(--paper-raised);
  border: 1px solid var(--rule);
  border-radius: 50%;
  color: var(--ink);
  cursor: pointer;
  box-shadow: var(--shadow);
  transition: background-color 0.2s ease, transform 0.15s ease;
}

.theme-menu-btn:hover {
  background: var(--paper-deep);
  transform: scale(1.05);
}

.theme-menu-dropdown {
  display: none;
  position: absolute;
  top: 48px;
  right: 0;
  width: 190px;
  background: var(--paper-raised);
  border: 1px solid var(--rule);
  border-radius: 12px;
  box-shadow: var(--shadow);
  padding: 12px;
  backdrop-filter: blur(12px);
}

.theme-menu-dropdown.is-open {
  display: block;
}

.menu-section-header {
  font-size: 11px;
  font-weight: 800;
  color: var(--rust-deep);
  letter-spacing: 0.8px;
  padding: 2px 4px 6px 4px;
}

.font-size-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--paper-deep);
  border: 1px solid var(--rule);
  border-radius: 8px;
  padding: 4px 6px;
}

.stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 28px;
  background: var(--paper-raised);
  border: 1px solid var(--rule);
  border-radius: 6px;
  color: var(--ink);
  cursor: pointer;
  transition: background-color 0.15s ease, transform 0.1s ease;
}

.stepper-btn:hover {
  background: var(--paper);
  color: var(--rust-deep);
  transform: scale(1.05);
}

.stepper-value {
  font-size: 12px;
  font-weight: 700;
  color: var(--ink);
  min-width: 44px;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.theme-menu-options {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.theme-menu-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 7px 8px;
  background: transparent;
  border: none;
  border-radius: 6px;
  color: var(--ink);
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 500;
  text-align: left;
  cursor: pointer;
  transition: background-color 0.15s ease;
}

.theme-menu-item:hover,
.theme-menu-item.is-selected {
  background: var(--paper-deep);
  color: var(--rust-deep);
  font-weight: 700;
}

.theme-menu-item .theme-icon {
  font-size: 14px;
}
"""

TOGGLE_HTML = """<div class="theme-menu-wrapper">
  <button id="theme-menu-button" class="theme-menu-btn" onclick="toggleThemeMenu(event)" aria-label="Toggle Reader Settings" title="Reader Settings">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>
  <div id="theme-menu-dropdown" class="theme-menu-dropdown">
    <!-- Font Size Section -->
    <div class="menu-section">
      <div class="menu-section-header">FONT SIZE</div>
      <div class="font-size-stepper">
        <button class="stepper-btn" onclick="adjustFontSize(-5)" title="Decrease Font Size" aria-label="Decrease Font Size">
          <span style="font-size: 11px; font-weight: 800;">A⁻</span>
        </button>
        <span id="font-size-label" class="stepper-value">100%</span>
        <button class="stepper-btn" onclick="adjustFontSize(5)" title="Increase Font Size" aria-label="Increase Font Size">
          <span style="font-size: 15px; font-weight: 800;">A⁺</span>
        </button>
      </div>
    </div>

    <!-- Theme Section -->
    <div class="menu-section" style="margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--rule);">
      <div class="menu-section-header">THEME</div>
      <div class="theme-menu-options">
        <button class="theme-menu-item" data-theme-val="auto" onclick="switchTheme('auto')">
          <span class="theme-icon">💻</span> Auto
        </button>
        <button class="theme-menu-item" data-theme-val="light" onclick="switchTheme('light')">
          <span class="theme-icon">📜</span> Paper Light
        </button>
        <button class="theme-menu-item" data-theme-val="dark" onclick="switchTheme('dark')">
          <span class="theme-icon">🌙</span> Paper Dark
        </button>
      </div>
    </div>
  </div>
</div>
<script>
  var currentFontSize = 100;

  function toggleThemeMenu(event) {
    event.stopPropagation();
    var menu = document.getElementById('theme-menu-dropdown');
    if (menu) menu.classList.toggle('is-open');
  }

  function adjustFontSize(delta) {
    var newSize = Math.min(145, Math.max(75, currentFontSize + delta));
    applyFontSize(newSize);
  }

  function applyFontSize(size) {
    currentFontSize = size;
    document.documentElement.style.fontSize = size + '%';
    var label = document.getElementById('font-size-label');
    if (label) label.textContent = size + '%';
    localStorage.setItem('gh-mlops-font-size', size);
  }

  function switchTheme(theme) {
    if (theme === 'auto') {
      delete document.documentElement.dataset.theme;
      localStorage.removeItem('gh-mlops-user-theme');
    } else {
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('gh-mlops-user-theme', theme);
    }
    updateSelectedThemeItem(theme);
    var menu = document.getElementById('theme-menu-dropdown');
    if (menu) menu.classList.remove('is-open');
  }

  function updateSelectedThemeItem(theme) {
    var items = document.querySelectorAll('.theme-menu-item');
    items.forEach(function(item) {
      if (item.getAttribute('data-theme-val') === theme) {
        item.classList.add('is-selected');
      } else {
        item.classList.remove('is-selected');
      }
    });
  }

  document.addEventListener('click', function(e) {
    var wrapper = document.querySelector('.theme-menu-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
      var menu = document.getElementById('theme-menu-dropdown');
      if (menu) menu.classList.remove('is-open');
    }
  });

  (function() {
    var savedTheme = localStorage.getItem('gh-mlops-user-theme') || 'auto';
    if (savedTheme !== 'auto') {
      document.documentElement.dataset.theme = savedTheme;
    }

    var savedFontSize = localStorage.getItem('gh-mlops-font-size');
    if (savedFontSize) {
      var parsedSize = parseInt(savedFontSize, 10);
      if (!isNaN(parsedSize)) {
        currentFontSize = parsedSize;
        document.documentElement.style.fontSize = parsedSize + '%';
      }
    }

    window.addEventListener('DOMContentLoaded', function() {
      updateSelectedThemeItem(savedTheme);
      var label = document.getElementById('font-size-label');
      if (label) label.textContent = currentFontSize + '%';
    });

    // ScrollSpy: highlight active TOC item as headings cross the viewport
    window.addEventListener('DOMContentLoaded', function() {
      var headings = document.querySelectorAll('h1[id], h2[id], h3[id], h4[id]');
      if (!headings.length) return;

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var id = entry.target.getAttribute('id');
            if (!id) return;
            var tocLinks = document.querySelectorAll('#TOC a');
            tocLinks.forEach(function(link) {
              if (link.getAttribute('href') === '#' + id) {
                link.classList.add('active');
                if (link.parentElement) link.parentElement.classList.add('active-li');
              } else {
                link.classList.remove('active');
                if (link.parentElement) link.parentElement.classList.remove('active-li');
              }
            });
          }
        });
      }, { rootMargin: '0px 0px -75% 0px', threshold: 0 });

      headings.forEach(function(h) {
        observer.observe(h);
      });
    });

    // Sticky Title Sentinel Observer: shrink title when stuck at top
    window.addEventListener('DOMContentLoaded', function() {
      var h1 = document.querySelector('body > h1, header > h1, main > h1, #title-block-header h1');
      if (!h1) return;

      var sentinel = document.createElement('div');
      sentinel.className = 'sticky-title-sentinel';
      sentinel.style.height = '1px';
      sentinel.style.marginBottom = '-1px';
      h1.parentNode.insertBefore(sentinel, h1);

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) {
            h1.classList.add('is-stuck');
          } else {
            h1.classList.remove('is-stuck');
          }
        });
      }, { threshold: [0] });

      observer.observe(sentinel);
    });
  })();
</script>
"""


def has_top_title(content: str) -> bool:
    """Check if markdown content has YAML title metadata or a # top-level heading."""
    lines = content.splitlines()
    in_yaml = False
    for i, line in enumerate(lines):
        line_strip = line.strip()
        if i == 0 and line_strip == "---":
            in_yaml = True
            continue
        if in_yaml:
            if line_strip == "---" or line_strip == "...":
                in_yaml = False
                continue
            if line_strip.startswith("title:"):
                return True
        else:
            if line_strip.startswith("# ") and not line_strip.startswith("##"):
                return True
    return False


def get_output_path(input_path: Path) -> Path:
    """Return output HTML path replacing .md with .html in the same directory."""
    filename = input_path.name
    if filename.endswith(".md"):
        out_name = filename[:-3] + ".html"
    else:
        out_name = input_path.stem + ".html"
    return input_path.parent / out_name


def convert_file(input_file: str, toc_depth: int = 2) -> None:
    input_path = Path(input_file)
    if not input_path.exists():
        print(f"Error: File '{input_file}' not found.", file=sys.stderr)
        sys.exit(1)

    output_path = get_output_path(input_path)

    content = input_path.read_text(encoding="utf-8", errors="replace")
    if has_top_title(content):
        fallback_title = None
    else:
        parent_dir = input_path.resolve().parent.name
        fallback_title = f"{parent_dir}/{input_path.stem}" if parent_dir else input_path.stem

    with (
        tempfile.NamedTemporaryFile("w", suffix=".css", delete=False) as css_tmp,
        tempfile.NamedTemporaryFile("w", suffix=".html", delete=False) as toggle_tmp,
    ):
        css_tmp.write(CSS_CONTENT)
        toggle_tmp.write(TOGGLE_HTML)
        css_path = css_tmp.name
        toggle_path = toggle_tmp.name

    try:
        cmd = [
            "pandoc",
            str(input_path),
            "-o",
            str(output_path),
            "--standalone",
            "--embed-resources",
            "--toc",
            f"--toc-depth={toc_depth}",
            "--css",
            css_path,
            "-B",
            toggle_path,
        ]
        if fallback_title:
            cmd.extend(["--metadata", f"title={fallback_title}"])

        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            print(f"Error converting '{input_file}':\n{res.stderr}", file=sys.stderr)
            sys.exit(res.returncode)

        file_size_kb = output_path.stat().st_size // 1024
        print(f"Converted: {input_path} -> {output_path} ({file_size_kb} KB)")
    finally:
        if os.path.exists(css_path):
            os.remove(css_path)
        if os.path.exists(toggle_path):
            os.remove(toggle_path)


def main():
    parser = argparse.ArgumentParser(
        description="Convert Markdown file(s) to HTML using Pandoc with embedded Paper Theme and dark/light mode switch."
    )
    parser.add_argument(
        "files",
        nargs="+",
        metavar="FILE",
        help="Markdown file(s) to convert (.md -> .html)",
    )
    parser.add_argument(
        "--toc-depth", type=int, default=2, help="Table of contents depth (default: 2)"
    )
    args = parser.parse_args()

    for file_path in args.files:
        convert_file(file_path, toc_depth=args.toc_depth)


if __name__ == "__main__":
    main()

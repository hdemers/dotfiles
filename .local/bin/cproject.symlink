#!/bin/bash

PROJET_DIR="/home/hdemers/Projets"
CUSTOM_DIRS=("$HOME/.dotfiles" "$HOME/.dotagents" "$HOME/.private")
FORCE=0

# Parse arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --force) FORCE=1; shift ;;
        *) TARGET="$1"; shift ;;
    esac
done

export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS' 
--color=fg:#c0caf5,bg:#24283b,hl:#bb9af7
--color=fg+:#c0caf5,bg+:#1b1e2d,hl+:#7dcfff
--color=info:#7aa2f7,prompt:#7dcfff,pointer:#7dcfff 
--color=marker:#9ece6a,spinner:#9ece6a,header:#9ece6a'

if [ -n "$TARGET" ] && [ -d "$TARGET" ]; then
    dir=$(realpath "$TARGET")
elif [ -n "$TARGET" ]; then
    dir=$(fd -H -d 4 -t d '^(\.git|\.jj)$' "${PROJET_DIR}" "${CUSTOM_DIRS[@]}" -x echo {//} | sort -u | grep -F "$TARGET" | head -1)
else
    dir=$(fd -H -d 4 -t d '^(\.git|\.jj)$' "${PROJET_DIR}" "${CUSTOM_DIRS[@]}" -x echo {//} | sort -u | fzf --height 100%)
fi

if [ -n "$dir" ]; then
    # Get the tab name from directory basename
    tab_name=$(basename "$dir")
    lock_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zellij-tab-title-locks"
    lock_file="$lock_dir/${ZELLIJ_SESSION_NAME:-default}"

    # Query existing tab names and check if our tab exists
    existing_tabs=$(zellij action query-tab-names)

    if [ "$FORCE" -eq 0 ] && echo "$existing_tabs" | grep -Fxq -- "$tab_name"; then
        # Resolve the destination independently of client focus and this launcher's pane.
        tab_id=$(zellij action list-tabs --json | node --input-type=module -e '
            import { readFileSync } from "node:fs";
            const tab = JSON.parse(readFileSync(0, "utf8")).find(tab => tab.name === process.argv[1]);
            if (!Number.isSafeInteger(tab?.tab_id)) process.exit(1);
            process.stdout.write(String(tab.tab_id));
        ' -- "$tab_name") || exit 1
        zellij action go-to-tab-name "$tab_name" || exit 1
    else
        # new-tab returns the created tab ID; do not infer it from later focus.
        tab_id=$(zellij action new-tab --name "$tab_name" --layout project --cwd "$dir") || exit 1

        mkdir -p "$lock_dir"
        if [ -n "$tab_id" ]; then
            touch "$lock_file"
            grep -qx "$tab_id" "$lock_file" || echo "$tab_id" >> "$lock_file"
        fi

        sleep 2
    fi

    # Show this project's recovery choices in the destination tab, not the tab
    # where Alt+g was pressed. The picker preselects all recoverable sessions.
    recovery="$HOME/.local/bin/pi-zellij"
    picker="$HOME/.local/bin/pi-zellij-pick"
    if [[ "$tab_id" =~ ^[0-9]+$ ]] && [ -x "$recovery" ] && [ -x "$picker" ]; then
        # Check before creating a pane, so an empty project does not flash a UI.
        # Exit 2 (attention needed) still opens the pane to keep failures visible.
        (cd -- "$dir" || exit 2; "$recovery" --check)
        recovery_status=$?
        if [ "$recovery_status" -ne 1 ]; then
            zellij action new-pane --floating --close-on-exit --tab-id "$tab_id" \
                --cwd "$dir" --name "Recover Pi sessions" \
                --x "30%" --y "12%" --width "40%" --height "50%" \
                -- bash -ic 'exec "$1" --close-on-success' bash "$picker"
        fi
    else
        printf '%s\n' "Project opened, but recovery is unavailable: check the tab ID, $recovery, and $picker"
    fi
fi

# vim set ft=sh

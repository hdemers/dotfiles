# vim: set ft=desktop:
[Desktop Entry]
Type=Application
Version=1.0
Name=Wezterm
GenericName=Wezterm
Comment=Wezterm terminal emulator
Exec=/home/linuxbrew/.linuxbrew/bin/wezterm start zsh -i -c "zellij attach -c $HOSTNAME"
StartupNotify=true
Terminal=false
Categories=Utility;ConsoleOnly;
Keywords=terminal;
StartupWMClass=Wezterm
Icon=/home/hdemers/.local/share/icons/wezterm-ghifarit53-3.svg

-- vim: set ft=lua:

-- Pull in the wezterm API
local wezterm = require 'wezterm'

-- This will hold the configuration.
local config = wezterm.config_builder()

local function file_exists(path)
  local file = io.open(path, 'r')
  if file then
    file:close()
    return true
  end
  return false
end

local function env_bool(name)
  local value = os.getenv(name)
  if value == nil or value == '' then
    return nil
  end
  value = string.lower(value)
  if value == '1' or value == 'true' or value == 'yes' or value == 'on' then
    return true
  elseif value == '0' or value == 'false' or value == 'no' or value == 'off' then
    return false
  end
  return nil
end

config.window_decorations = 'NONE'
config.status_update_interval = 100
config.use_fancy_tab_bar = false
config.tab_max_width = 32

-- Daily AMD-display mode keeps Mutter on AMD and WezTerm can use Wayland.
-- Gaming/NVIDIA-display mode disables the Mutter AMD-primary udev rule, and
-- WezTerm should use X11 because Wayland is unreliable in that profile.
-- Override manually with WEZTERM_ENABLE_WAYLAND=1 or 0 if needed.
local wayland_override = env_bool 'WEZTERM_ENABLE_WAYLAND'
if wayland_override ~= nil then
  config.enable_wayland = wayland_override
else
  config.enable_wayland = file_exists '/etc/udev/rules.d/61-mutter-primary-gpu.rules'
end
-- config.enable_kitty_keyboard = true

-- ═══════════════════════════════════════════════════════════════════════════════════════
-- Font configuration
-- ═══════════════════════════════════════════════════════════════════════════════════════

-- Default font
local font_family = 'Sudo Var'

local mux = wezterm.mux
wezterm.on('gui-startup', function(cmd)
  local _, _, window = mux.spawn_window(cmd or {})
  window:gui_window():maximize()
end)

config.font = wezterm.font { family = font_family }
if font_family == 'Sudo Var' then
  config.font_size = 12.5
elseif font_family == 'Hack' then
  config.font_size = 12
  config.line_height = 1.00
elseif font_family == 'FiraCode Nerd Font' then
  config.font_size = 10
elseif font_family == 'JetBrains Mono' then
  config.font_size = 11
elseif font_family == 'GeistMono' then
  config.font_size = 11
elseif string.match(font_family, '^Iosevka') then
  config.font_size = 12
elseif string.match(font_family, '^Monaspace') then
  config.font_size = 13
  config.harfbuzz_features = {
    'calt',
    'ss01',
    'ss02',
    'ss03',
    'ss04',
    'ss05',
    'ss06',
    'ss07',
    'ss08',
    'ss09',
    'liga',
  }
else
  config.font_size = 11
end

-- ═══════════════════════════════════════════════════════════════════════════════════════
-- Default program
-- ═══════════════════════════════════════════════════════════════════════════════════════

-- By default we launch zsh if available, otherwise fall back to bash
if file_exists '/usr/bin/zsh' then
  config.default_prog = { '/usr/bin/zsh' }
elseif file_exists '/home/linuxbrew/.linuxbrew/bin/zsh' then
  config.default_prog = { '/home/linuxbrew/.linuxbrew/bin/zsh' }
else
  config.default_prog = { 'bash' }
end

-- ═══════════════════════════════════════════════════════════════════════════════════════
--  Color scheme
--  Scheme based on distrobox name, with tab bar color matching.
--  Light/dark toggle via Ctrl+Alt+T.
-- ═══════════════════════════════════════════════════════════════════════════════════════

-- Distrobox configurations: name -> { dark = scheme, light = scheme }
local distroboxes = {
  ['work-dev'] = { dark = 'Tokyo Night Storm', light = 'Tokyo Night Day' },
  ['ubuntu'] = { dark = 'Catppuccin Mocha', light = 'Catppuccin Latte' },
}

-- Default scheme (no distrobox active)
local DEFAULT_DARK = 'Kanagawa (Gogh)'
local DEFAULT_LIGHT = 'GruvboxLight'

-- Returns the color scheme for a distrobox name + theme mode (or default)
local function get_distrobox_scheme(name, is_dark)
  local entry = distroboxes[name]
  if entry then
    return is_dark and entry.dark or entry.light
  end
  return is_dark and DEFAULT_DARK or DEFAULT_LIGHT
end

-- Initialize global theme state (only on first load; preserves state across config reloads)
if wezterm.GLOBAL.is_dark == nil then
  wezterm.GLOBAL.is_dark = true
  wezterm.GLOBAL.desired_scheme = DEFAULT_DARK
  config.color_scheme = DEFAULT_DARK
end

-- Creates a keybinding action to switch to or spawn a distrobox tab
local function distrobox_tab_action(name)
  return wezterm.action_callback(function(win, pane)
    -- Search for existing tab with this distrobox
    local mux_win = win:mux_window()
    for _, tab in ipairs(mux_win:tabs()) do
      for _, p in ipairs(tab:panes()) do
        if p:get_user_vars().CONTAINER_ID == name then
          tab:activate()
          return
        end
      end
    end

    -- Not found, spawn new tab. We bridge the container's own CONTAINER_ID
    -- (exported by distrobox) into a WezTerm user var via OSC 1337: WezTerm
    -- cannot read shell env vars, so an escape sequence is the only channel.
    -- It runs inside the container (where CONTAINER_ID is set) but before
    -- zellij starts, so it reliably reaches WezTerm (zellij would otherwise
    -- swallow the sequence).
    win:perform_action(
      wezterm.action.SpawnCommandInNewTab {
        args = {
          '/bin/bash',
          '-c',
          'exec /usr/bin/distrobox enter '
            .. name
            .. " -- /bin/bash -c '"
            .. [[printf "\033]1337;SetUserVar=CONTAINER_ID=%s\007" "$(printf %s "$CONTAINER_ID" | base64 -w0)"; exec /home/linuxbrew/.linuxbrew/bin/zellij attach --forget -c ]]
            .. name
            .. "'",
        },
      },
      pane
    )
  end)
end

-- Fixed window title (except for zellij-nvim)
wezterm.on('format-window-title', function(tab, pane, tabs, panes, cfg)
  return ''
end)

-- Tab bar palettes are defined further down; forward-declared here so that
-- apply_scheme_for_state can reference them (a Lua local is only in scope after
-- its declaration, so without this the override would silently resolve to nil).
local DARK_TAB_BAR, LIGHT_TAB_BAR

-- Push a color-scheme report to the active pane's program over its stdin.
-- WezTerm doesn't implement DEC mode 2031 natively (wezterm/wezterm#6454), so
-- we emulate the terminal's push ourselves: send_text writes to the pane's pty
-- input, which zellij forwards to its active pane. TUIs that subscribed with
-- `CSI ? 2031 h` (e.g. the Pi agent with theme=auto) parse
-- `CSI ? 997 ; Ps n` (Ps=1 dark, Ps=2 light) and switch theme live.
local function notify_theme_to_active_pane(window, is_dark)
  local pane = window:active_pane()
  if pane then
    pane:send_text(string.format('\027[?997;%sn', is_dark and '1' or '2'))
  end
end

-- Apply scheme + tab bar for the current container + theme. When the resolved
-- scheme actually changes (toggle or tab switch), also notify the active TUI.
local function apply_scheme_for_state(window)
  local container_id = window:active_pane():get_user_vars().CONTAINER_ID
  local is_dark = wezterm.GLOBAL.is_dark
  local scheme = get_distrobox_scheme(container_id, is_dark)
  local changed = scheme ~= wezterm.GLOBAL.desired_scheme
  wezterm.GLOBAL.desired_scheme = scheme
  local overrides = window:get_config_overrides() or {}
  overrides.color_scheme = scheme
  overrides.colors = { tab_bar = is_dark and DARK_TAB_BAR or LIGHT_TAB_BAR }
  window:set_config_overrides(overrides)
  if changed then
    notify_theme_to_active_pane(window, is_dark)
  end
end

-- Instant color change when user var is set (on spawn)
wezterm.on('user-var-changed', function(window, pane, name, value)
  if name == 'CONTAINER_ID' then
    apply_scheme_for_state(window)
  end
end)

-- Re-apply scheme when the active tab changes. update-status fires on tab
-- switches and periodically (status_update_interval), so the window-level
-- color_scheme override follows whichever distrobox tab is focused. Guarded
-- so set_config_overrides runs only when the scheme actually differs;
-- window-config-reloaded still restores overrides unconditionally after a reload.
wezterm.on('update-status', function(window, pane)
  local container_id = window:active_pane():get_user_vars().CONTAINER_ID
  local scheme = get_distrobox_scheme(container_id, wezterm.GLOBAL.is_dark)
  if scheme ~= wezterm.GLOBAL.desired_scheme then
    apply_scheme_for_state(window)
  end
end)

-- Toggle light/dark theme
local function toggle_theme_action()
  return wezterm.action_callback(function(win, pane)
    wezterm.GLOBAL.is_dark = not wezterm.GLOBAL.is_dark
    -- Flipping is_dark changes the resolved scheme, so apply_scheme_for_state
    -- both recolors WezTerm and pushes a CSI ? 997 report to the active pane,
    -- letting TUIs on DEC mode 2031 follow the toggle live.
    apply_scheme_for_state(win)
  end)
end

-- ═══════════════════════════════════════════════════════════════════════════════════════
--  Tab bar formatting: colors based on active/inactive/hover and seamless
--  arrows between tabs
-- ═══════════════════════════════════════════════════════════════════════════════════════

DARK_TAB_BAR = {
  background = '#24283b',
  active_tab = { bg_color = '#9ECE6A', fg_color = '#282828' },
  inactive_tab = { bg_color = '#C0CAF5', fg_color = '#282828' },
  inactive_tab_hover = { bg_color = '#7AA2F7', fg_color = '#282828' },
  new_tab = { bg_color = '#BB9AF7', fg_color = '#282828' },
  new_tab_hover = { bg_color = '#7AA2F7', fg_color = '#282828' },
}

LIGHT_TAB_BAR = {
  background = '#e1e2e7',
  active_tab = { bg_color = '#9ECE6A', fg_color = '#282828' },
  inactive_tab = { bg_color = '#C0CAF5', fg_color = '#282828' },
  inactive_tab_hover = { bg_color = '#7AA2F7', fg_color = '#282828' },
  new_tab = { bg_color = '#BB9AF7', fg_color = '#282828' },
  new_tab_hover = { bg_color = '#7AA2F7', fg_color = '#282828' },
}

config.colors = {
  tab_bar = DARK_TAB_BAR,
}

-- Resolve tab title from distrobox name, SSH hostname, or system hostname
local function get_tab_title(tab)
  if tab.tab_title and tab.tab_title ~= '' then
    return '  ' .. tab.tab_title .. '  '
  end
  local container_id = tab.active_pane.user_vars.CONTAINER_ID
  if container_id and container_id ~= '' then
    return '  󰕈  ' .. container_id .. '  '
  end

  local process_name = tab.active_pane.foreground_process_name or ''
  if process_name:match 'ssh$' then
    local title = tab.active_pane.title or ''
    local host = title:match '@([^:%s]+)' or title:match '^([^@:%s]+)'
    if host and host ~= '' then
      return '    ' .. host .. '  '
    end
  end

  local host = wezterm.hostname()
  if host and host ~= '' then
    return '    ' .. host .. '  '
  end

  return ''
end

local SOLID_RIGHT = wezterm.nerdfonts.pl_left_hard_divider

-- Pick the active tab bar palette based on current theme
local function tab_bar_colors()
  return wezterm.GLOBAL.is_dark and DARK_TAB_BAR or LIGHT_TAB_BAR
end

local function tab_bg(t)
  local tb = tab_bar_colors()
  return t.is_active and tb.active_tab.bg_color or tb.inactive_tab.bg_color
end

-- Dynamic tab title formatting (scheme changes handled by explicit events)
wezterm.on('format-tab-title', function(tab, tabs, panes, cfg, hover, max_width)
  local tb = tab_bar_colors()
  local title = get_tab_title(tab)
  local bg = tab.is_active and tb.active_tab.bg_color or tb.inactive_tab.bg_color
  local fg = tab.is_active and tb.active_tab.fg_color or tb.inactive_tab.fg_color

  -- Find the next tab's background color (or bar bg if last tab)
  local next_bg = tb.background
  for _, t in ipairs(tabs) do
    if t.tab_index == tab.tab_index + 1 then
      next_bg = tab_bg(t)
      break
    end
  end

  local elements = {}

  -- Leading arrow only for the first tab (bar bg → this tab)
  if tab.tab_index == 0 then
    table.insert(elements, { Background = { Color = bg } })
    table.insert(elements, { Foreground = { Color = tb.background } })
    table.insert(elements, { Text = SOLID_RIGHT })
  end

  -- Tab content
  table.insert(elements, { Background = { Color = bg } })
  table.insert(elements, { Foreground = { Color = fg } })
  table.insert(elements, { Text = ' ' .. title .. ' ' })

  -- Trailing arrow (this tab → next tab or bar bg). Seamless transition.
  table.insert(elements, { Background = { Color = next_bg } })
  table.insert(elements, { Foreground = { Color = bg } })
  table.insert(elements, { Background = { Color = tb.background } })
  table.insert(elements, { Text = SOLID_RIGHT })
  table.insert(elements, { Foreground = { Color = tb.background } })
  table.insert(elements, { Background = { Color = next_bg } })
  table.insert(elements, { Text = SOLID_RIGHT })

  return elements
end)

-- Re-apply scheme on window focus/reload (ensures overrides survive config reloads)
wezterm.on('window-config-reloaded', function(window, pane)
  apply_scheme_for_state(window)
end)

-- ═══════════════════════════════════════════════════════════════════════════════════════
--  Keybindings
-- ═══════════════════════════════════════════════════════════════════════════════════════

config.keys = {
  { key = 'n', mods = 'CTRL|SHIFT', action = wezterm.action.DisableDefaultAssignment },
  { key = 'p', mods = 'CTRL|SHIFT', action = wezterm.action.DisableDefaultAssignment },
  { key = 'Enter', mods = 'ALT', action = wezterm.action.DisableDefaultAssignment },
  { key = 'w', mods = 'CTRL|ALT', action = distrobox_tab_action 'work-dev' },
  { key = 'u', mods = 'CTRL|ALT', action = distrobox_tab_action 'ubuntu' },
  { key = 't', mods = 'CTRL|ALT', action = toggle_theme_action() },
  -- Tab navigation
  {
    key = 'h',
    mods = 'CTRL|SHIFT',
    action = wezterm.action.ActivateTabRelative(-1),
  },
  {
    key = 'l',
    mods = 'CTRL|SHIFT',
    action = wezterm.action.ActivateTabRelative(1),
  },
  -- Allow Shift-Enter to send a literal Enter to the terminal. Useful in Claude
  -- Code among other places.
  {
    key = 'Enter',
    mods = 'SHIFT',
    action = wezterm.action { SendString = '\x1b\r' },
  },
}

return config
